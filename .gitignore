# Whitelist: only code, simulations and results are public. Plans, notes, analytics, renders and credentials stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/engine/
!/sims/
!/assets/
!/videos/
__pycache__/
build/
audio/
*.log
*.wav
*.mp3
*.mp4
.env
client_secret*.json
token*.json
